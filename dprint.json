{
  "useTabs": true,
  "json": { "useTabs": true },
  "malva": { "useTabs": true },
  "markup": { "useTabs": true },
  "biome": { "indentStyle": "tab" },
  "includes": [
    "claude/**/*.{md,json,jsonc,css,html,js,mjs}",
    "opencode/**/*.{md,json,jsonc,css,html,js,mjs}",
    "omo/**/*.{md,json,jsonc,css,html,js,mjs}",
    "agents/**/*.{md,json,jsonc,css,html,js,mjs}"
  ],
  "excludes": [
    "**/*.py",
    "**/*.yaml",
    "**/*.yml",
    "**/*-lock.json",
    "**/node_modules",
    "**/__pycache__",
    "**/scripts/fixtures/**",
    "omo/teach/**/lessons/**",
    "omo/teach/**/reference/*.html"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.19.0.wasm",
    "https://plugins.dprint.dev/json-0.20.0.wasm",
    "https://plugins.dprint.dev/biome-0.9.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.11.1.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.21.0.wasm"
  ]
}
