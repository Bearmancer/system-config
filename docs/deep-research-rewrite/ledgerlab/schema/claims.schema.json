{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "claims.yaml",
	"type": "object",
	"required": ["schema", "claims"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": 1 },
		"claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
	},
	"$defs": {
		"evidence": {
			"type": "object",
			"required": ["source", "locator", "quote", "stance"],
			"additionalProperties": false,
			"properties": {
				"source": { "type": "string", "pattern": "^s[0-9]+$" },
				"locator": { "type": "string", "minLength": 1 },
				"quote": { "type": "string", "minLength": 1 },
				"stance": { "enum": ["supports", "contradicts"] },
				"read_by": { "type": "string" },
				"text_corroboration": { "type": "boolean" },
				"note": { "type": "string" }
			}
		},
		"position": {
			"type": "object",
			"required": ["text", "sources"],
			"additionalProperties": false,
			"properties": {
				"text": { "type": "string", "minLength": 1 },
				"holders": { "type": "array", "items": { "type": "string" } },
				"sources": { "type": "array", "items": { "type": "string", "pattern": "^s[0-9]+$" }, "minItems": 1 }
			}
		},
		"claim": {
			"type": "object",
			"required": ["id", "text", "hash", "status", "origin", "rounds", "paradigms_tried", "evidence"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^c[0-9]+$" },
				"text": { "type": "string", "minLength": 1 },
				"hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
				"status": { "enum": ["true", "untrue", "interpretive", "not-found", "open"] },
				"origin": { "enum": ["discovered", "misconception", "extracted-from-input", "extracted-from-prose"] },
				"rounds": { "type": "integer", "minimum": 0, "maximum": 5 },
				"paradigms_tried": { "type": "array", "items": { "type": "string" } },
				"evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
				"independence": {
					"type": "object",
					"required": ["rationale"],
					"additionalProperties": false,
					"properties": { "rationale": { "type": "string", "minLength": 1 } }
				},
				"positions": { "type": "array", "items": { "$ref": "#/$defs/position" } },
				"tags": { "type": "array", "items": { "enum": ["visual-read"] } },
				"anchors": { "type": "array", "items": { "type": "string" } },
				"parent": { "type": "string", "pattern": "^c[0-9]+$" }
			}
		}
	}
}
