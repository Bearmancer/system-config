{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run",
      "bearerTokenEnv": "EXA_API_KEY"
    },
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/",
      "bearerTokenEnv": "TAVILY_API_KEY"
    },
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "bearerTokenEnv": "FIRECRAWL_API_KEY"
    },
    "apify": {
      "url": "https://mcp.apify.com?tools=actors,docs,runs,storage,tasks,schedules,builds,dev,get-actor-list,apify/rag-web-browser,apify/web-fetch",
      "bearerTokenEnv": "APIFY_TOKEN"
    },
    "browserbase": {
      "url": "https://mcp.browserbase.com/mcp",
      "bearerTokenEnv": "BROWSERBASE_API_KEY"
    },
    "agentql": {
      "connectTimeoutMs": 120000,
      "command": "node",
      "args": ["C:/Users/Lance/AppData/Roaming/npm/node_modules/agentql-mcp/dist/index.js"],
      "env": { "AGENTQL_API_KEY": "${AGENTQL_API_KEY}" }
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "scrapegraph": {
      "url": "https://mcp.scrapegraphai.com/mcp",
      "headers": { "Authorization": "Bearer ${SCRAPEGRAPH_API_KEY}" }
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "firefox-devtools": {
      "connectTimeoutMs": 120000,
      "command": "firefox-devtools-mcp",
      "args": [
        "--profile-path", "C:/Users/Lance/.firefox-devtools-mcp/profile/firefox_devtools_mcp_profile",
        "--firefox-path", "C:/Program Files/Mozilla Firefox/firefox.exe",
        "--viewport", "1280x720",
        "--tool-preset", "all"
      ]
    },
    "brightdata": {
      "connectTimeoutMs": 120000,
      "command": "node",
      "args": ["C:/Users/Lance/AppData/Roaming/npm/node_modules/@brightdata/mcp/server.js"],
      "env": { "API_TOKEN": "${BRIGHTDATA_API_KEY}" }
    },
    "github": {
      "command": "C:\\Users\\Lance\\.local\\bin\\github-mcp-server.exe",
      "args": ["stdio"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    "playwright": {
      "connectTimeoutMs": 120000,
      "command": "node",
      "args": ["C:/Users/Lance/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js"]
    },
    "sequential-thinking": {
      "connectTimeoutMs": 120000,
      "command": "node",
      "args": ["C:/Users/Lance/AppData/Roaming/npm/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"]
    }
  }
}
