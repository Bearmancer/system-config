// OMO configuration — MAXIMALIST merge (2026-09-11): disk post-migration detail + baseline opt-in blocks.
// MERGE PROVENANCE: base = C:\Users\Lance\.omo\omo.jsonc (2026-08-reasoning-unification, 306 lines);
// added = 14 absent baseline blocks + top-level global pins; changed = 2 values; backup beside this file.
// IMPORTANT: quit and restart the harness after changing this file —
// config is loaded once at startup and is NOT hot-reloaded.
// LAYERING (global-first): top-level keys are the global base every harness
// inherits. [opencode] holds ONLY opencode-only keys plus true shadows
// (values that must differ from global). Resolution order per the loader:
// global base -> [harness] shadow -> profile base -> profile shadow.
// HEPHAESTUS: intentionally absent from every agents map (operator order beats
// maximalism; absence is the disable mechanism — never add a stub).
{
	// Schema for editor validation and autocomplete. RETAIN: same URL both sources.
	"$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
	// Named configuration profiles (empty = defaults everywhere). RETAIN: no overlay active.
	"profiles": {},
	// Skill allowlist (opencode harness): only these are discoverable/loadable by the agent.
	// OMO builtin skills are added after this filter, so they stay enabled.
	// OPENCODE-ONLY scope: keys the runtime rejects anywhere else.
	"[opencode]": {
