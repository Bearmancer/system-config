    "team_mode": {
      "enabled": true,
      "tmux_visualization": true,
      "max_parallel_members": 8,
      "max_members": 8,
      "base_dir": ".claude",
      "max_member_turns": 500,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "mailbox_poll_interval_ms": 3000,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": true,
      "git_env_prefix": "GIT_MASTER=1"
    },
    "hashline_edit": false,
    "model_fallback": true,
    "auto_update": true,
    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 100
    },
    "claude_code": {
      "plugins": false
    },
    "disabled_providers": [
      "Anthropic"
    ],
    "keyword_detector": {
      "enabled_expansions": [
        "hyperplan",
        "hyperplan-ultrawork",
        "team",
        "ultrawork"
      ]
    },
    "monitor": {
      "enabled": true,
      "live_mode_enabled": true,
      "max_monitors_per_session": 16,
      "max_runtime_ms": 1800000,
      "batch_max_lines": 50,
      "batch_max_bytes": 16384,
      "flush_interval_ms": 1000,
      "ring_max_lines": 1000,
      "line_max_bytes": 8192,
      "pattern_max_length": 512
    },
    "notification": {
      "force_enable": true
    },
    "babysitting": {
      "timeout_ms": 120000
    },
    "runtime_fallback": true,
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true
    },
    "sisyphus_agent": {
      "disabled": false,
      "default_builder_enabled": true,
      "planner_enabled": true,
      "tdd": true
    },
    "start_work": {
      "auto_commit": true
    },
    "experimental": {
      "task_system": false,
      "safe_hook_creation": true,
      "hashline_edit": true,
      "model_fallback_title": true,
      "disable_omo_env": false,
      "disable_live_parent_wake_routing": false
    }
