{
	"$schema": "https://opencode.ai/config.json",
	"shell": "C:\\Users\\Lance\\.local\\pwsh\\pwsh.exe",
	"model": "opencode/mimo-v2.6-flash-free",
	"small_model": "opencode/mimo-v2.6-flash-free",

	"providers": {
		"opencode-go": {
			"models": {
				"deepseek-v4-flash": {
					"disabled": true,
				},
				"deepseek-v4-flash-vision-exp": {
					"disabled": true,
				},
				"deepseek-v4-pro": {
					"disabled": true,
				},
				"glm-5.2": {
					"disabled": true,
				},
				"glm-5.3": {
					"disabled": true,
				},
				"glm-5.3-flash": {
					"disabled": true,
				},
				"gpt-5.6-luna": {
					"disabled": true,
				},
				"gpt-6-luna": {
					"disabled": true,
				},
				"grok-4.6": {
					"disabled": true,
				},
				"grok-4.7": {
					"disabled": true,
				},
				"hy3": {
					"disabled": true,
				},
				"hy4-preview": {
					"disabled": true,
				},
				"kimi-k2.7-code": {
					"disabled": true,
				},
				"kimi-k3": {
					"disabled": true,
				},
				"longcat-2.0": {
					"disabled": true,
				},
				"longcat-2.5-preview-free": {
					"disabled": true,
				},
				"mimo-v2.5": {
					"disabled": true,
				},
				"mimo-v2.5-pro": {
					"disabled": true,
				},
				"mimo-v2.6-pro": {
					"disabled": true,
				},
				"minimax-m2.7": {
					"disabled": true,
				},
				"minimax-m3": {
					"disabled": true,
				},
				"muse-spark-1.2-contributor": {
					"disabled": true,
				},
				"qwen3.8-max": {
					"disabled": true,
				},
				"space-bunny-free": {
					"disabled": true,
				},
			},
		},
	},
	"agents": {
		"build": {
			"model": "opencode/mimo-v2.6-flash-free",
		},
		"plan": {
			"model": "opencode/mimo-v2.6-flash-free",
		},
		"general": {
			"disabled": true,
		},
		"explore": {
			"disabled": true,
		},
		"researcher": {
			"description": "Web researcher. Use for any web lookup, scrape, search or crawl.",
			"mode": "subagent",
			"model": "opencode/mimo-v2.6-flash-free",
			"system": "Use the web MCP tools (via execute) for every question. Report exact returned text with source URLs.",
		},
	},
	"mcp": {
		"timeout": {
			"startup": 120000,
		},
		"servers": {
			"exa": {
				"type": "remote",
				"url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run",
				"headers": {
					"Authorization": "Bearer {file:~/.config/opencode/secrets/exa}",
				},
				"oauth": false,
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"tavily": {
				"type": "remote",
				"url": "https://mcp.tavily.com/mcp/",
				"headers": {
					"Authorization": "Bearer {file:~/.config/opencode/secrets/tavily}",
				},
				"oauth": false,
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"firecrawl": {
				"type": "remote",
				"url": "https://mcp.firecrawl.dev/v2/mcp",
				"headers": {
					"Authorization": "Bearer {file:~/.config/opencode/secrets/firecrawl}",
				},
				"oauth": false,
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"apify": {
				"type": "remote",
				"url": "https://mcp.apify.com?tools=actors,docs,runs,storage,tasks,schedules,builds,dev,get-actor-list,apify/rag-web-browser,apify/web-fetch",
				"headers": {
					"Authorization": "Bearer {file:~/.config/opencode/secrets/apify}",
				},
				"oauth": false,
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"browserbase": {
				"type": "remote",
				"url": "https://mcp.browserbase.com/mcp",
				"headers": {
					"Authorization": "Bearer {file:~/.config/opencode/secrets/browserbase}",
				},
				"oauth": false,
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"agentql": {
				"type": "local",
				"command": [
					"node",
					"C:/Users/Lance/AppData/Roaming/npm/node_modules/agentql-mcp/dist/index.js",
				],
				"environment": {
					"AGENTQL_API_KEY": "{file:~/.config/opencode/secrets/agentql}",
				},
				"timeout": {
					"startup": 120000,
					"catalog": 60000,
					"execution": 30000,
				},
			},
			"microsoft-learn": {
				"type": "remote",
				"url": "https://learn.microsoft.com/api/mcp",
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"scrapegraph": {
				"type": "remote",
				"url": "https://mcp.scrapegraphai.com/mcp",
				"headers": {
					"Authorization": "Bearer {file:~/.config/opencode/secrets/scrapegraph}",
				},
				"timeout": {
					"catalog": 60000,
					"execution": 120000,
				},
			},
			"codegraph": {
				"type": "local",
				"command": ["codegraph", "serve", "--mcp"],
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"firefox-devtools": {
				"type": "local",
				"command": [
					"firefox-devtools-mcp",
					"--profile-path",
					"C:/Users/Lance/.firefox-devtools-mcp/profile/firefox_devtools_mcp_profile",
					"--firefox-path",
					"C:/Program Files/Mozilla Firefox/firefox.exe",
					"--viewport",
					"1280x720",
					"--tool-preset",
					"all",
				],
				"timeout": {
					"startup": 120000,
					"catalog": 60000,
					"execution": 30000,
				},
			},
			"brightdata": {
				"type": "local",
				"command": [
					"node",
					"C:/Users/Lance/AppData/Roaming/npm/node_modules/@brightdata/mcp/server.js",
				],
				"environment": {
					"API_TOKEN": "{file:~/.config/opencode/secrets/brightdata}",
				},
				"timeout": {
					"startup": 120000,
					"catalog": 60000,
					"execution": 30000,
				},
			},
			"github": {
				"type": "local",
				"command": [
					"C:\\Users\\Lance\\.local\\bin\\github-mcp-server.exe",
					"stdio",
				],
				"environment": {
					"GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/opencode/secrets/github}",
				},
			},
			"playwright": {
				"type": "local",
				"command": [
					"node",
					"C:/Users/Lance/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js",
				],
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
			"sequential-thinking": {
				"type": "local",
				"command": [
					"node",
					"C:/Users/Lance/AppData/Roaming/npm/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js",
				],
				"timeout": {
					"catalog": 30000,
					"execution": 30000,
				},
			},
		},
	},
	"plugin": [
		"oh-my-opencode-slim",

		"@slkiser/opencode-quota@next",
	],
	"lsp": {
		"typescript": {
			"command": ["typescript-language-server", "--stdio"],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".mts",
				".cts",
			],
		},
		"json": {
			"command": ["vscode-json-language-server", "--stdio"],
			"extensions": [".json", ".jsonc"],
		},
		"csharp": {
			"command": ["csharp-ls"],
			"extensions": [".cs", ".csx"],
		},
		"pyright": {
			"command": [
				"C:/Users/Lance/AppData/Local/Python/pythoncore-3.14-64/Scripts/basedpyright-langserver.exe",
				"--stdio",
			],
			"extensions": [".py", ".pyi"],
		},
		"powershell": {
			"command": [
				"pwsh",
				"-NoLogo",
				"-NoProfile",
				"-NonInteractive",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"C:/Users/Lance/Documents/PowerShell/Modules/PowerShellEditorServices/Start-EditorServices.ps1",
				"-HostName",
				"OpenCode",
				"-HostProfileId",
				"OpenCode",
				"-HostVersion",
				"1.0",
				"-Stdio",
			],
			"extensions": [".ps1", ".psm1", ".psd1"],
		},
		"bash": {
			"command": ["bash-language-server", "start"],
			"extensions": [".sh", ".bash", ".zsh", ".ksh"],
		},
	},
	"formatter": true,
	"compaction": {
		"auto": false,
		"prune": false,
	},
	"plugins": [
		"@cortexkit/opencode-magic-context@latest",
		"@dietrichgebert/ponytail",
	],
}
