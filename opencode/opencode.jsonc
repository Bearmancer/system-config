{
	"plugin": [
    "./plugins/caveman/plugin.js",
    "oh-my-openagent@latest"
  ],
	"$schema": "https://opencode.ai/config.json",
	"shell": "C:\\Users\\Lance\\.local\\pwsh\\pwsh.exe",
	"lsp": {
		"typescript": {
			"command": [
				"tsc",
				"--lsp",
				"--stdio",
			],
			"extensions": [
				".ts",
				".tsx",
				".mts",
				".cts",
			],
		},
		"biome": {
			"command": [
				"biome",
				"lsp-proxy",
				"--stdio",
			],
			"extensions": [
				".js",
				".jsx",
				".mjs",
				".cjs",
				".jsonc",
			],
		},
		"ty": {
			"command": [
				"ty",
				"server",
			],
			"extensions": [
				".py",
				".pyi",
			],
		},
		"pyright": {
			"disabled": true,
		},
		"global-json-schema": {
			"command": [
				"vscode-json-language-server",
				"--stdio",
			],
			"extensions": [
				".json",
			],
			"initialization": {
				"json": {
					"validate": {
						"enable": true,
					},
				},
			},
		},
		"eslint": {
			"disabled": true,
		},
		"oxlint": {
			"disabled": true,
		},
		"deno": {
			"disabled": true,
		},
	},
	"permission": {
		"bash": {
			"git reflog *": "ask",
			"git rebase*": "deny",
			"git pull *--rebase*": "deny",
			"git pull -r*": "deny",
			"git pull * -r*": "deny",
			"git reset *--hard*": "deny",
			"git clean*": "deny",
			"git restore*": "deny",
			"git checkout -B*": "deny",
			"git checkout -f*": "deny",
			"git checkout * -f*": "deny",
			"git checkout *--force*": "deny",
			"git checkout * -- *": "deny",
			"git checkout .": "deny",
			"git checkout * .": "deny",
			"git switch -C*": "deny",
			"git switch -f*": "deny",
			"git switch * -f*": "deny",
			"git switch *--force*": "deny",
			"git switch *--discard-changes*": "deny",
			"git tag -d*": "deny",
			"git tag -f*": "deny",
			"git tag --delete*": "deny",
			"git stash drop*": "deny",
			"git stash clear*": "deny",
			"git reflog delete*": "deny",
			"git reflog expire*": "deny",
			"git filter-branch*": "deny",
			"git update-ref*": "deny",
			"git gc *--prune*": "deny",
			"git prune*": "deny",
		},
	},
	"disabled_providers": [
		"anthropic",
	],
	"model": "opencode-go/muse-spark-1.3-contributor#xhigh",
	"small_model": "opencode-go/muse-spark-1.3-contributor",
	"mcp": {
		"firefox-devtools": {
			"type": "local",
			"command": [
				"cmd",
				"/c",
				"npx",
				"-y",
				"@mozilla/firefox-devtools-mcp@latest",
				"--profile-path",
				"C:/Users/Lance/.firefox-devtools-mcp/profile/firefox_devtools_mcp_profile",
				"--firefox-path",
				"C:/Program Files/Mozilla Firefox/firefox.exe",
				"--viewport",
				"1280x720",
				"--tool-preset",
				"all",
			],
			"enabled": false,
		},
		"codegraph": {
			"type": "local",
			"command": [
				"codegraph",
				"serve",
				"--mcp",
			],
			"timeout": 30000,
		},
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run",
			"headers": {
				"x-api-key": "{env:EXA_API_KEY}",
			},
			"oauth": false,
			"timeout": 30000,
		},
		"microsoft-learn": {
			"type": "remote",
			"url": "https://learn.microsoft.com/api/mcp",
			"enabled": true,
			"timeout": 30000,
		},
		"firecrawl": {
			"type": "local",
			"command": [
				"node",
				"C:/Users/Lance/.config/opencode/node_modules/firecrawl-mcp/dist/index.js",
			],
			"environment": {
				"FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}",
				"LOG_LEVEL": "error",
			},
			"timeout": 30000,
		},
		"dappier": {
			"type": "local",
			"command": ["uvx", "--with", "mcp<2", "dappier-mcp"],
			"environment": {
				"DAPPIER_API_KEY": "{env:DAPPIER_API_KEY}",
			},
			"enabled": false,
			"timeout": 30000,
		},
		"scrapegraph": {
			"type": "local",
			"command": ["uvx", "scrapegraph-mcp"],
			"environment": {
				"SGAI_API_KEY": "{env:SCRAPEGRAPH_API_KEY}",
			},
			"enabled": false,
			"timeout": 30000,
		},
		"tavily": {
			"type": "remote",
			"url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
			"oauth": false,
			"timeout": 30000,
		},
		"context7": {
			"type": "local",
			"command": [
				"cmd",
				"/c",
				"npx",
				"-y",
				"mcp-remote",
				"https://mcp.context7.com/mcp",
				"--transport",
				"http-only",
				"--header",
				"Authorization:Bearer {env:CONTEXT7_API_KEY}"
			],
			"enabled": true,
		},
	},
	"autoupdate": false,
	"experimental": {
		"batch_tool": true,
		"continue_loop_on_deny": true,
		"disable_paste_summary": true,
	},
	"tool_output": {
		"max_bytes": 204800,
	},
  "formatter": true
}
