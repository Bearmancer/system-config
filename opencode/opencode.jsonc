{
  "$schema": "https://opencode.ai/config.json",
  "shell": "C:\\Users\\Lance\\.local\\pwsh\\pwsh.exe",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "agents": {
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free#xhigh"
    },
    "plan": {
      "model": "opencode/muse-spark-1.3-contributor-free#xhigh"
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "researcher": {
      "description": "Web researcher. Use for any web lookup, scrape, search or crawl.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "system": "Use the web MCP tools (via execute) for every question. Report exact returned text with source URLs."
    }
  },
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/exa}"
        },
        "oauth": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/tavily}"
        },
        "oauth": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/firecrawl}"
        },
        "oauth": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "apify": {
        "type": "remote",
        "url": "https://mcp.apify.com?tools=apify/rag-web-browser,search-actors,call-actor",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/apify}"
        },
        "oauth": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "browserbase": {
        "type": "remote",
        "disabled": true,
        "url": "https://mcp.browserbase.com/mcp",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/browserbase}"
        },
        "oauth": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "agentql": {
        "type": "local",
        "disabled": true,
        "command": [
          "npx",
          "-y",
          "agentql-mcp"
        ],
        "environment": {
          "AGENTQL_API_KEY": "{file:~/.config/opencode/secrets/agentql}"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 30000
        }
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "scrapegraph": {
        "type": "local",
        "command": [
          "scrapegraph-mcp"
        ],
        "environment": {
          "SGAI_API_KEY": "{file:~/.config/opencode/secrets/scrapegraph}"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 30000
        }
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "firefox-devtools-mcp",
          "--profile-path",
          "C:/Users/Lance/.firefox-devtools-mcp/profile/firefox_devtools_mcp_profile",
          "--firefox-path",
          "C:/Program Files/Mozilla Firefox/firefox.exe",
          "--viewport",
          "1280x720",
          "--tool-preset",
          "all"
        ],
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 30000
        }
      },
      "brightdata": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@brightdata/mcp"
        ],
        "environment": {
          "API_TOKEN": "{file:~/.config/opencode/secrets/brightdata}"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 30000
        }
      }
    }
  },
  "plugin": [
    "oh-my-opencode-slim",
    // OpenCode Quota: loads the server plugin for slash commands and quota checks.
    "@slkiser/opencode-quota@next"
  ],
  "lsp": true,
  "formatter": true
}
