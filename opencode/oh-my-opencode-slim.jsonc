{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",

	"preset": "opencode-go",
	"presets": {
		"opencode-go": {
			"orchestrator": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
						"variant": "high",
					},
				],
				"skills": [
					"*",
				],
				"mcps": [
					"*",
				],
			},
			"oracle": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
						"variant": "xhigh",
					},
				],
				"skills": [
					"simplify",
				],
				"mcps": [],
			},
			"explorer": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
						"variant": "low",
					},
				],
				"skills": [],
				"mcps": [],
			},
			"librarian": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
						"variant": "low",
					},
				],
				"skills": [
					"deep-research",
				],
				"mcps": [
					"*",
				],
			},
			"designer": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
					},
				],
				"skills": [],
				"mcps": [],
			},
			"fixer": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
						"variant": "high",
					},
				],
				"skills": [],
				"mcps": [],
			},
			"observer": {
				"model": [
					{
						"id": "opencode/mimo-v2.6-flash-free",
					},
				],
				"skills": [],
				"mcps": [],
			},
		},
	},

	"disabled_agents": [],

	"image_routing": "auto",

	"multiplexer": {
		"type": "tmux",
		"layout": "main-vertical",
		"main_pane_size": 60,
	},

	"companion": {
		"enabled": false,
		"position": "bottom-right",
		"size": "medium",
		"gifPack": "default",
		"loopStyle": "classic",
		"speed": 1,
		"debug": false,
	},

	"backgroundJobs": {
		"maxSessionsPerAgent": 3,
		"strategy": "checkpoint-compatible",
		"maxRetainedSnapshots": 20,
		"orchestratorWake": {
			"enabled": true,
			"intervalMs": 300000,
			"mode": "auto",
			"wakeOnTerminalPublication": true,
			"publicationWakeMinIntervalMs": 30000,
		},
		"wallClockTimeoutMs": 1800000,
		"abortGraceMs": 15000,
		"stopConfirmationMs": 8000,
		"boardInjection": true,
		"waitForUserGuard": true,
		"concurrency": {
			"defaultConcurrency": 4,
			"providerConcurrency": {
				"opencode": 4,
				"opencode-go": 4,
			},
		},
	},

	"fallback": {
		"enabled": true,
		"maxRetries": 3,
		"initialRetryDelayMs": 0,
		"retryDelayMs": 500,
	},

	"interview": {
		"maxQuestions": 4,
		"outputFolder": "interview",
		"autoOpenBrowser": true,
		"dashboard": true,
	},

	"council": {
		"default_preset": "allowed",
		"presets": {
			"allowed": {
				"alpha": {
					"model": [
						{
							"id": "opencode/mimo-v2.6-flash-free",
							"variant": "high",
						},
					],
					"prompt": "Argue from first principles; optimise for correctness and long-term maintainability.",
				},
				"beta": {
					"model": [
						{
							"id": "opencode/mimo-v2.6-flash-free",
							"variant": "high",
						},
					],
					"prompt": "Be the pragmatic implementer; optimise for the cheapest correct change and cite concrete evidence.",
				},
				"gamma": {
					"model": [
						{
							"id": "opencode/mimo-v2.6-flash-free",
							"variant": "high",
						},
					],
					"prompt": "Be the adversarial reviewer; hunt for failure modes, edge cases, and hidden costs.",
				},
			},
		},
	},
	"autoUpdate": true,
	"compactSidebar": false,
}
