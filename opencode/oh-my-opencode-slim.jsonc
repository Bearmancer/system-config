{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	// ── MODEL POLICY (user constraint) ────────────────────────────────────────
	// All roles use opencode-go/muse-spark-1.3-contributor.
	// ──────────────────────────────────────────────────────────────────────────
	"preset": "opencode-go",
	"presets": {
		"opencode-go": {
			"orchestrator": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor",
						"variant": "high"
					}
				],
				"skills": [
					"*"
				],
				"mcps": [
					"*"
				]
			},
			"oracle": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor",
						"variant": "max"
					}
				],
				"skills": [
					"simplify"
				],
				"mcps": []
			},
			"explorer": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor",
						"variant": "low"
					}
				],
				"skills": [],
				"mcps": []
			},
			"librarian": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor",
						"variant": "low"
					}
				],
				"skills": [
					"deep-research"
				],
				"mcps": [
					"*"
				]
			},
			"designer": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor"
					}
				],
				"skills": [],
				"mcps": []
			},
			"fixer": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor",
						"variant": "high"
					}
				],
				"skills": [],
				"mcps": []
			},
			"observer": {
				"model": [
					{
						"id": "opencode-go/muse-spark-1.3-contributor"
					}
				],
				"skills": [],
				"mcps": []
			}
		}
	},
	// Observer is disabled by default upstream; [] turns it ON (all-features).
	"disabled_agents": [],
	// Image attachments route to the Observer agent (read-only visual analysis).
	"image_routing": "auto",
	// ── Multiplexer: psmux (tmux-compatible) instead of tmux ──────────────────
	// psmux exports tmux-compatible TMUX / TMUX_PANE, so the tmux adapter is the
	// correct driver. Requires a reachable server: `psmux` then `opencode --port N`.
	"multiplexer": {
		"type": "tmux",
		"layout": "main-vertical",
		"main_pane_size": 60
	},
	// ── Desktop companion: OFF (user request) ─────────────────────────────────
	"companion": {
		"enabled": false,
		"position": "bottom-right",
		"size": "medium",
		"gifPack": "default",
		"loopStyle": "classic",
		"speed": 1,
		"debug": false
	},
	// ── Background orchestration (full opt-in set) ────────────────────────────
	"backgroundJobs": {
		"maxSessionsPerAgent": 3,
		"strategy": "checkpoint-compatible",
		"maxRetainedSnapshots": 20,
		"orchestratorWake": {
			"enabled": true,
			"intervalMs": 300000,
			"mode": "auto",
			"wakeOnTerminalPublication": true,
			"publicationWakeMinIntervalMs": 30000
		},
		"wallClockTimeoutMs": 1800000,
		"abortGraceMs": 15000,
		"stopConfirmationMs": 8000,
		"boardInjection": true,
		"waitForUserGuard": true,
		"concurrency": {
			"defaultConcurrency": 4,
			"providerConcurrency": {
				"opencode": 4,
				"opencode-go": 4
			}
		}
	},
	// ── Foreground model-chain failover ───────────────────────────────────────
	"fallback": {
		"enabled": true,
		"maxRetries": 3,
		"initialRetryDelayMs": 0,
		"retryDelayMs": 500
	},
	// ── Interview (/interview browser Q&A -> structured spec) ─────────────────
	"interview": {
		"maxQuestions": 4,
		"outputFolder": "interview",
		"autoOpenBrowser": true,
		"dashboard": true
	},
	// ── Council: multi-model consensus, allowed models only ───────────────────
	"council": {
		"default_preset": "allowed",
		"presets": {
			"allowed": {
				"alpha": {
					"model": [
						{
							"id": "opencode-go/muse-spark-1.3-contributor",
							"variant": "high"
						}
					],
					"prompt": "Argue from first principles; optimise for correctness and long-term maintainability."
				},
				"beta": {
					"model": [
						{
							"id": "opencode-go/muse-spark-1.3-contributor",
							"variant": "high"
						}
					],
					"prompt": "Be the pragmatic implementer; optimise for the cheapest correct change and cite concrete evidence."
				},
				"gamma": {
					"model": [
						{
							"id": "opencode-go/muse-spark-1.3-contributor",
							"variant": "high"
						}
					],
					"prompt": "Be the adversarial reviewer; hunt for failure modes, edge cases, and hidden costs."
				}
			}
		}
	},
	"autoUpdate": true,
	"compactSidebar": false
}